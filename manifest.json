{
    "manifest_version": 2,
    "name": "troll-patrol",
    "version": "1.0",
  
    "description": "Adds a blur overlay to the reported users/posters of facebook",

    "permissions": ["contextMenus", "activeTab", "tabs", "clipboardWrite", "scripting", "storage", "downloads", "https://raw.githubusercontent.com/*", "https://trollpatrolapi.vercel.app/api/reports"],

    "background": {
      "scripts": ["background.js"]
    },

    "icons": {
      "48": "icons/logo.png"
    },
    
    "content_scripts": [
      {
        "matches": ["*://*.facebook.com/*"],
        "css":["content.css"],
        "js": ["bloomfilter.js", "troll-patrol.js", "content.js"]
      }
    ]
  }
  