{
    "manifest_version": 2,
    "name": "troll-patrol",
    "version": "1.0",
  
    "description": "Adds a red border to all webpages matching mozilla.org.",

    "permissions": ["contextMenus", "activeTab", "tabs", "clipboardWrite", "scripting", "storage", "downloads"],

    "background": {
      "scripts": ["background.js"]
    },

    "icons": {
      "48": "icons/border-48.png"
    },
  
    "content_scripts": [
      {
        "matches": ["*://*.facebook.com/*"],
        "css":["content.css"],
        "js": ["bloomfilter.js", "troll-patrol.js", "content.js"]
      }
    ]
  }
  